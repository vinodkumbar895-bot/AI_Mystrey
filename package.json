{
  "name": "ai-mystery-room",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": { "node": ">=20" },
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "format": "prettier --write \"client/**/*.{ts,tsx,css,json}\" \"server/**/*.{ts,json}\" \"docs/**/*.md\" README.md AGENTS.md package.json eslint.config.js .prettierrc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0"
  }
}

